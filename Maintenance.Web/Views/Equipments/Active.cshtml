
@model List<Maintenance.Domain.Entities.Equipment>

@{
    ViewData["Title"] = "تجهیزات فعال";
}

<style>
    .equipment-page {
        direction: rtl;
        min-height: 85vh;
        padding: 40px 24px;
        background: #f4f6fa;
        color: #263449;
    }

    .equipment-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 30px;
    }

        .page-header h2 {
            font-size: 25px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .page-header p {
            color: #778398;
            font-size: 14px;
            margin: 0;
        }

    .summary-card {
        background: #fff;
        border: 1px solid #e8edf4;
        border-radius: 15px;
        padding: 20px 24px;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 4px 15px rgba(30, 50, 80, .04);
    }

    .summary-label {
        color: #778398;
        font-size: 13px;
        margin-bottom: 7px;
    }

    .summary-number {
        font-size: 27px;
        font-weight: 800;
        color: #263449;
    }

    .summary-icon {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        background: #e8f6ef;
        color: #24965c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .table-card {
        background: #fff;
        border: 1px solid #e8edf4;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(30, 50, 80, .04);
    }

    .table-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
        font-weight: 800;
        font-size: 16px;
    }

    .table-responsive {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 600px;
    }

    thead {
        background: #f8f9fc;
    }

    th, td {
        padding: 17px 22px;
        text-align: right;
        border-bottom: 1px solid #edf0f5;
        font-size: 13px;
    }

    th {
        color: #778398;
        font-weight: 700;
    }

    td {
        color: #344258;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover {
        background: #fafbfe;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 12px;
        border-radius: 20px;
        background: #e8f6ef;
        color: #218653;
        font-size: 12px;
        font-weight: 700;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #24965c;
    }

    .empty-state {
        text-align: center;
        padding: 55px 20px;
        color: #778398;
    }

    .empty-icon {
        font-size: 38px;
        margin-bottom: 14px;
    }

    .empty-state h4 {
        color: #344258;
        font-size: 16px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 17px;
        border-radius: 9px;
        background: #263c5a;
        color: white !important;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 700;
        transition: .2s;
    }

        .back-link:hover {
            background: #192b43;
            transform: translateY(-2px);
        }
</style>

<div class="equipment-page">
    <div class="equipment-container">

        <div class="page-header">
            <div>
                <h2>تجهیزات فعال</h2>
                <p>فهرست تجهیزات فعال در سیستم مدیریت تعمیرات</p>
            </div>

            <a href="@Url.Action("Index", "Equipments")" class="back-link">
                <span>→</span>
                بازگشت به فهرست تجهیزات
            </a>
        </div>

        <div class="summary-card">
            <div>
                <div class="summary-label">تعداد تجهیزات فعال</div>
                <div class="summary-number">@Model.Count</div>
            </div>

            <div class="summary-icon">✓</div>
        </div>

        <div class="table-card">
            <div class="table-header">
                فهرست تجهیزات
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>شناسه</th>
                                <th>نام تجهیز</th>
                                <th>وضعیت</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var equipment in Model)
                            {
                                <tr>
                                    <td>@equipment.Id</td>
                                    <td>@equipment.Name</td>
                                    <td>
                                        <span class="status">
                                            <span class="status-dot"></span>
                                            فعال
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">⚙</div>
                    <h4>تجهیز فعال وجود ندارد</h4>
                    <p>در حال حاضر هیچ تجهیز فعالی در سیستم ثبت نشده است.</p>
                </div>
            }
        </div>

    </div>
</div>
```